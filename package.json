{
  "name": "@halal-restaurants/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:api": "tsx apps/api/src/main.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "start:jobs:ui": "tsx apps/bull-board/src/main.ts",
    "dev:jobs:ui": "tsx watch apps/bull-board/src/main.ts",
    "start:bull-board": "tsx apps/bull-board/src/main.ts",
    "start:kfc": "npm run start -w apps/mobile-kfc",
    "start:kfc:web": "npm run web -w apps/mobile-kfc",
    "start:kfc:android": "npm run android -w apps/mobile-kfc",
    "start:kfc:ios": "npm run ios -w apps/mobile-kfc",
    "start:nandos": "npm run start -w apps/mobile-nandos",
    "start:nandos:web": "npm run web -w apps/mobile-nandos",
    "start:nandos:android": "npm run android -w apps/mobile-nandos",
    "start:nandos:ios": "npm run ios -w apps/mobile-nandos",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "prisma generate --schema=libs/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=libs/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=libs/database/prisma/schema.prisma",
    "scrape:kfc": "node kfc-scraper.mjs",
    "scrape:nandos": "node nandos-scraper.mjs",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:build": "docker compose -f docker/docker-compose.yml build"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "23.3.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-native": "^0.72.8",
    "eslint": "^10.12.0",
    "nx": "23.3.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/fastify": "^9.10.4",
    "@bull-board/ui": "^9.10.4",
    "@expo/metro-runtime": "^57.0.17",
    "@fastify/cors": "^11.3.1",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "^5.104.2",
    "bullmq": "^6.3.15",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "react-dom": "^19.3.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  }
}
