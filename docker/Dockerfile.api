# Multi-stage Dockerfile for Halal Restaurants REST API
FROM node:22-alpine AS builder

WORKDIR /app

# Install OpenSSL for Prisma
RUN apk add --no-cache openssl libc6-compat

# Copy package manifests
COPY package.json package-lock.json tsconfig.base.json nx.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY libs/database/package.json ./libs/database/
COPY libs/jobs/package.json ./libs/jobs/
COPY libs/scrapers/package.json ./libs/scrapers/
COPY libs/types/package.json ./libs/types/
COPY libs/ui/package.json ./libs/ui/

# Install dependencies
RUN npm ci

# Copy database schema and generate Prisma client
COPY libs/database/prisma ./libs/database/prisma/
RUN npx prisma generate --schema=libs/database/prisma/schema.prisma

# Copy source code
COPY libs/ ./libs/
COPY apps/api/ ./apps/api/

# Production runner stage
FROM node:22-alpine AS runner

WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0
ENV DATABASE_URL="file:/app/data/dev.db"

# Copy build artifacts and dependencies from builder
COPY --from=builder /app /app

# Volume for persistent SQLite storage
VOLUME [ "/app/data" ]

EXPOSE 3001

CMD ["npm", "start", "-w", "apps/api"]

