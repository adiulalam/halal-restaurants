datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Dedicated table for KFC UK restaurants
model KfcRestaurant {
  id                   String   @id @default(cuid())
  storeId              String   @unique
  refId                String?
  name                 String
  street               String?
  city                 String?
  postalCode           String?
  country              String   @default("GB")
  latitude             Float?
  longitude            Float?
  region               String?
  isHalal              Boolean  @default(false)
  hasDriveThru         Boolean  @default(false)
  hasWifi              Boolean  @default(false)
  hasDisabilityAccess  Boolean  @default(false)
  hasBabyChanging      Boolean  @default(false)
  isVeganFriendly      Boolean  @default(false)
  judoPayId            String?
  status               String?
  bagTaxType           String?
  defaultEtaMin        Int?
  defaultEtaMax        Int?
  facilitiesJson       String?
  orderModesJson       String?
  openingHoursJson     String?
  detailUrl            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isHalal])
  @@index([postalCode])
  @@index([city])
}

// Dedicated table for Nando's UK restaurants
model NandosRestaurant {
  id                   String   @id @default(cuid())
  branchCode           String   @unique
  name                 String
  slug                 String?
  seoSlug              String?
  street               String?
  city                 String?
  postalCode           String?
  country              String   @default("GB")
  latitude             Float?
  longitude            Float?
  region               String?
  telephone            String?
  isHalal              Boolean  @default(false)
  hasOutdoorSeating    Boolean  @default(false)
  hasBabyChanging      Boolean  @default(false)
  hasDisabledAccess    Boolean  @default(false)
  hasWifi              Boolean  @default(false)
  hasDelivery          Boolean  @default(false)
  hasCollection        Boolean  @default(false)
  status               String?
  mapCID               String?
  amenitiesJson        String?
  orderChannelsJson    String?
  openingHoursJson     String?
  detailUrl            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isHalal])
  @@index([postalCode])
  @@index([city])
}

// Audit log for periodic scraper runs
model ScrapeAuditLog {
  id           String   @id @default(cuid())
  chain        String   // 'KFC' | 'NANDOS'
  totalScraped Int
  halalCount   Int
  status       String   // 'SUCCESS' | 'FAILED'
  errorMessage String?
  durationMs   Int
  createdAt    DateTime @default(now())
}

